// CLIMARTE ERP — schema.prisma
// Sprint 1: entidades de fundación técnica (Usuario, Rol, ConfiguracionParticipacion).
// Los modelos de los sprints siguientes (Cliente, Trabajo, Gastos, etc.) se agregan
// en sus propios sprints, según el Plan de Desarrollo (Parte 4).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NombreRol {
  ADMIN_SOCIO
  TECNICO
  ADMINISTRATIVO
}

enum EstadoComercial {
  CONSULTA
  PRESUPUESTO
  PRESUPUESTO_ENVIADO
  APROBADO
  RECHAZADO
}

enum EstadoOperativo {
  PROGRAMADO
  EN_EJECUCION
  FINALIZADO
  CANCELADO
}

enum EstadoPago {
  PENDIENTE
  PARCIAL
  COBRADO
}

enum RolEnTrabajo {
  RESPONSABLE
  PARTICIPANTE
  COLABORADOR_EXTERNO
}

enum TipoCosto {
  MATERIALES
  TRANSPORTE
  MANO_OBRA_EXTERNA
  OTRO
}

model Rol {
  id        String    @id @default(uuid())
  nombre    NombreRol @unique
  creadoEn  DateTime  @default(now()) @map("creado_en")

  usuarios  Usuario[]

  @@map("roles")
}

model Usuario {
  id            String   @id @default(uuid())
  nombre        String
  email         String   @unique
  passwordHash  String   @map("password_hash")
  activo        Boolean  @default(true)
  rolId         String   @map("rol_id")
  rol           Rol      @relation(fields: [rolId], references: [id])
  creadoEn      DateTime @default(now()) @map("creado_en")

  configuracionesParticipacion ConfiguracionParticipacion[] @relation("SocioConfiguracion")
  configuracionesCreadas       ConfiguracionParticipacion[] @relation("CreadorConfiguracion")
  participacionesEnTrabajos    TrabajoParticipante[]
  costosPagados                CostoTrabajo[]

  @@map("usuarios")
}

// Participación societaria versionada — nunca se toca desde módulos operativos
// (Trabajos, etc.). Ver Parte 1 §1.1/§12 y Parte 3 §6/§7.
model ConfiguracionParticipacion {
  id             String    @id @default(uuid())
  socioId        String    @map("socio_id")
  socio          Usuario   @relation("SocioConfiguracion", fields: [socioId], references: [id])
  porcentaje     Decimal   @db.Decimal(5, 2)
  vigenteDesde   DateTime  @map("vigente_desde")
  vigenteHasta   DateTime? @map("vigente_hasta")
  creadoPorId    String    @map("creado_por_id")
  creadoPor      Usuario   @relation("CreadorConfiguracion", fields: [creadoPorId], references: [id])
  creadoEn       DateTime  @default(now()) @map("creado_en")

  @@map("configuracion_participacion")
}

// Sprint 2 — Módulo de Clientes (Parte 2 §2, Parte 3 §6).
model Cliente {
  id             String    @id @default(uuid())
  nombre         String
  telefono       String
  whatsapp       String?
  direccion      String?
  localidad      String?
  observaciones  String?
  creadoEn       DateTime  @default(now()) @map("creado_en")

  trabajos       Trabajo[]

  @@map("clientes")
}

// Sprint 3 — Módulo de Trabajos (Parte 2 §3, Parte 3 §6/§8).
// Catálogos configurables (Parte 1 §3).
model TipoServicio {
  id       String    @id @default(uuid())
  nombre   String    @unique
  trabajos Trabajo[]

  @@map("tipos_servicio")
}

model TipoEquipo {
  id       String    @id @default(uuid())
  nombre   String    @unique
  trabajos Trabajo[]

  @@map("tipos_equipo")
}

// Persona contratada puntualmente, no es Usuario del sistema (Parte 1 §4, Parte 3 §6).
model ColaboradorExterno {
  id             String              @id @default(uuid())
  nombre         String
  telefono       String?
  observaciones  String?

  participaciones TrabajoParticipante[]

  @@map("colaboradores_externos")
}

model Trabajo {
  id                    String          @id @default(uuid())
  clienteId             String          @map("cliente_id")
  cliente               Cliente         @relation(fields: [clienteId], references: [id])
  fecha                 DateTime        @default(now())
  tipoEquipoId           String          @map("tipo_equipo_id")
  tipoEquipo             TipoEquipo      @relation(fields: [tipoEquipoId], references: [id])
  tipoServicioId          String          @map("tipo_servicio_id")
  tipoServicio            TipoServicio    @relation(fields: [tipoServicioId], references: [id])
  descripcion            String?

  // Los tres estados son independientes entre sí (Parte 2 §3.2, ya definido).
  estadoComercial        EstadoComercial @default(CONSULTA) @map("estado_comercial")
  estadoOperativo        EstadoOperativo @default(PROGRAMADO) @map("estado_operativo")
  estadoPago             EstadoPago      @default(PENDIENTE) @map("estado_pago")

  precioPresupuestado    Decimal?        @db.Decimal(12, 2) @map("precio_presupuestado")
  precioFinal            Decimal?        @db.Decimal(12, 2) @map("precio_final")
  formaPago              String?         @map("forma_pago")

  // Garantía por defecto 3 meses (Parte 2 §3.6, ya definido).
  garantiaDias           Int             @default(90) @map("garantia_dias")
  garantiaObservaciones  String?         @map("garantia_observaciones")

  observaciones          String?
  creadoPorId            String          @map("creado_por_id")
  creadoEn               DateTime        @default(now()) @map("creado_en")

  participantes          TrabajoParticipante[]
  costos                 CostoTrabajo[]
  gastosVariables        GastoVariable[]
  registrosCombustible   RegistroCombustible[]

  @@map("trabajos")
}

// Nunca tiene relación con ConfiguracionParticipacion — participar de un trabajo
// no modifica la participación societaria (Parte 1 §23, Parte 3 §7).
model TrabajoParticipante {
  id                    String              @id @default(uuid())
  trabajoId             String              @map("trabajo_id")
  trabajo               Trabajo             @relation(fields: [trabajoId], references: [id], onDelete: Cascade)
  usuarioId             String?             @map("usuario_id")
  usuario               Usuario?            @relation(fields: [usuarioId], references: [id])
  colaboradorExternoId  String?             @map("colaborador_externo_id")
  colaboradorExterno    ColaboradorExterno? @relation(fields: [colaboradorExternoId], references: [id])
  rolEnTrabajo          RolEnTrabajo        @map("rol_en_trabajo")
  horasDedicadas        Decimal?            @db.Decimal(6, 2) @map("horas_dedicadas")

  @@map("trabajo_participantes")
}

// La mano de obra de los socios NUNCA es un costo (Parte 2 §1.6, ya definido) —
// por eso el enum TipoCosto no incluye un valor "mano_obra" para socios.
model CostoTrabajo {
  id              String    @id @default(uuid())
  trabajoId       String    @map("trabajo_id")
  trabajo         Trabajo   @relation(fields: [trabajoId], references: [id], onDelete: Cascade)
  tipo            TipoCosto
  importe         Decimal   @db.Decimal(12, 2)
  descripcion     String?
  pagadoPorId     String?   @map("pagado_por_id")
  pagadoPor       Usuario?  @relation(fields: [pagadoPorId], references: [id])
  comprobanteUrl  String?   @map("comprobante_url")
  creadoEn        DateTime  @default(now()) @map("creado_en")

  @@map("costos_trabajo")
}
// Sprint 4 — Gastos, Vehículo y Herramientas (Plan de Desarrollo, Parte 4 §3).

enum PeriodicidadGasto {
  MENSUAL
  TRIMESTRAL
  ANUAL
}

enum EstadoHerramienta {
  ACTIVA
  DADA_DE_BAJA
}

model CategoriaGasto {
  id        String   @id @default(uuid())
  nombre    String   @unique
  creadoEn  DateTime @default(now()) @map("creado_en")

  gastosFijos     GastoFijo[]
  gastosVariables GastoVariable[]

  @@map("categorias_gasto")
}

model Proveedor {
  id             String   @id @default(uuid())
  nombre         String
  telefono       String?
  observaciones  String?
  creadoEn       DateTime @default(now()) @map("creado_en")

  gastosVariables GastoVariable[]

  @@map("proveedores")
}

// Gasto recurrente del negocio (alquiler, seguro, etc.), no asociado a un trabajo puntual.
model GastoFijo {
  id             String            @id @default(uuid())
  categoriaId    String            @map("categoria_id")
  categoria      CategoriaGasto    @relation(fields: [categoriaId], references: [id])
  importeMensual Decimal           @db.Decimal(12, 2) @map("importe_mensual")
  periodicidad   PeriodicidadGasto @default(MENSUAL)
  descripcion    String?
  activo         Boolean           @default(true)
  creadoEn       DateTime          @default(now()) @map("creado_en")

  @@map("gastos_fijos")
}

// Gasto puntual. Si tiene trabajoId es costo directo de ese trabajo;
// si no, es gasto general del negocio (regla no negociable del sprint).
model GastoVariable {
  id             String         @id @default(uuid())
  categoriaId    String         @map("categoria_id")
  categoria      CategoriaGasto @relation(fields: [categoriaId], references: [id])
  proveedorId    String?        @map("proveedor_id")
  proveedor      Proveedor?     @relation(fields: [proveedorId], references: [id])
  trabajoId      String?        @map("trabajo_id")
  trabajo        Trabajo?       @relation(fields: [trabajoId], references: [id])
  importe        Decimal        @db.Decimal(12, 2)
  fecha          DateTime       @default(now())
  descripcion    String?
  comprobanteUrl String?        @map("comprobante_url")
  creadoEn       DateTime       @default(now()) @map("creado_en")

  @@map("gastos_variables")
}

model Vehiculo {
  id        String   @id @default(uuid())
  marca     String
  modelo    String
  patente   String   @unique
  creadoEn  DateTime @default(now()) @map("creado_en")

  registrosCombustible RegistroCombustible[]
  registrosService     RegistroService[]

  @@map("vehiculos")
}

// Combustible sin trabajoId asociado = gasto general del vehículo.
model RegistroCombustible {
  id         String   @id @default(uuid())
  vehiculoId String   @map("vehiculo_id")
  vehiculo   Vehiculo @relation(fields: [vehiculoId], references: [id])
  trabajoId  String?  @map("trabajo_id")
  trabajo    Trabajo? @relation(fields: [trabajoId], references: [id])
  fecha      DateTime @default(now())
  litros     Decimal? @db.Decimal(8, 2)
  importe    Decimal  @db.Decimal(12, 2)
  creadoEn   DateTime @default(now()) @map("creado_en")

  @@map("registros_combustible")
}

// porcentajeAtribuido es editable por evento; importeAtribuido se calcula
// en el service (importeTotal * porcentajeAtribuido / 100) y se guarda ya resuelto.
model RegistroService {
  id                  String   @id @default(uuid())
  vehiculoId          String   @map("vehiculo_id")
  vehiculo            Vehiculo @relation(fields: [vehiculoId], references: [id])
  fecha               DateTime @default(now())
  descripcion         String
  importeTotal        Decimal  @db.Decimal(12, 2) @map("importe_total")
  porcentajeAtribuido Decimal  @db.Decimal(5, 2) @map("porcentaje_atribuido")
  importeAtribuido    Decimal  @db.Decimal(12, 2) @map("importe_atribuido")
  creadoEn            DateTime @default(now()) @map("creado_en")

  @@map("registros_service")
}

model Herramienta {
  id           String            @id @default(uuid())
  nombre       String
  categoria    String?
  fechaCompra  DateTime?         @map("fecha_compra")
  importe      Decimal?          @db.Decimal(12, 2)
  estado       EstadoHerramienta @default(ACTIVA)
  creadoEn     DateTime          @default(now()) @map("creado_en")

  @@map("herramientas")
}