# Normalización de fin de línea: en el repositorio siempre LF, también en
# el working copy de Windows. Evita diffs falsos entre máquinas.
* text=auto eol=lf

# Archivos que deben conservar CRLF sí o sí (scripts de Windows).
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Archivos que deben conservar LF sí o sí (se ejecutan dentro de contenedores).
*.sh text eol=lf
Dockerfile text eol=lf

# Binarios: git no los toca.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Lockfiles: se versionan pero no ensucian el diff en las revisiones.
package-lock.json -diff linguist-generated
